{
  "manifest_version": 3,
  "name": "Webpage Chat",
  "version": "0.1.0",
  "description": "Chat with any webpage in real time.",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Webpage Chat"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
